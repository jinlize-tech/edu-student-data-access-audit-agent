{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jinlize.tech/education/JLZ-EDU-AG-033/input.schema.json",
  "title": "学员数据地图与权限审计输入契约",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "data_status",
    "contains_sensitive_data",
    "systems_inventory",
    "data_fields",
    "user_roles",
    "access_matrix",
    "retention_policy",
    "student_data_categories",
    "change_context"
  ],
  "properties": {
    "contract_version": {
      "const": "1.2.0"
    },
    "data_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "partially_confirmed",
        "unconfirmed"
      ],
      "description": "输入资料的确认状态"
    },
    "contains_sensitive_data": {
      "type": "boolean"
    },
    "requested_output_language": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en"
      ],
      "default": "zh-CN"
    },
    "systems_inventory": {
      "title": "系统与表格清单",
      "description": "系统、表格、位置和负责人",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "data_fields": {
      "title": "学生数据字段",
      "description": "字段类别和必要性",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "user_roles": {
      "title": "用户角色",
      "description": "岗位和访问需求",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "access_matrix": {
      "title": "现有访问矩阵",
      "description": "谁可读、写、导出和删除",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "vendor_list": {
      "title": "供应商与共享",
      "description": "接收方和用途",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "retention_policy": {
      "title": "保留与删除规则",
      "description": "期限和责任人",
      "type": "string",
      "minLength": 1
    },
    "student_data_categories": {
      "title": "学生敏感数据类别",
      "description": "仅分类，不上传原始数据",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "change_context": {
      "title": "变更背景",
      "description": "新系统、离职审计或季度复核",
      "type": "string",
      "minLength": 1
    },
    "resume_mode": {
      "type": "string",
      "enum": [
        "new",
        "resume",
        "target_change",
        "stage_rollback"
      ],
      "default": "new"
    },
    "agent_state": {
      "type": "object",
      "required": [
        "state_version",
        "product_id",
        "current_stage",
        "stage_status",
        "completed_stages",
        "confirmed_facts",
        "open_questions",
        "human_confirmation",
        "recovery_context",
        "change_log",
        "minimal_context"
      ],
      "properties": {
        "state_version": {
          "const": "1.2.0"
        },
        "product_id": {
          "const": "JLZ-EDU-AG-033"
        },
        "current_stage": {
          "type": "string",
          "enum": [
            "S1_SCOPE_CONFIRMATION",
            "S2_EVIDENCE_INVENTORY",
            "S3_PROFESSIONAL_DIAGNOSIS",
            "S4_SOLUTION_DESIGN",
            "S5_HUMAN_CONFIRMATION",
            "S6_FINAL_DELIVERY",
            "PAUSED",
            "FAILED"
          ]
        },
        "stage_status": {
          "type": "string",
          "enum": [
            "in_progress",
            "paused",
            "completed",
            "failed"
          ]
        },
        "completed_stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "S1_SCOPE_CONFIRMATION",
              "S2_EVIDENCE_INVENTORY",
              "S3_PROFESSIONAL_DIAGNOSIS",
              "S4_SOLUTION_DESIGN",
              "S5_HUMAN_CONFIRMATION",
              "S6_FINAL_DELIVERY"
            ]
          },
          "uniqueItems": true
        },
        "confirmed_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fact_id",
              "statement",
              "source_refs",
              "confirmed_by"
            ],
            "properties": {
              "fact_id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confirmed_by": {
                "type": "string",
                "minLength": 1
              },
              "confirmed_at": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question_id",
              "question",
              "blocking",
              "owner"
            ],
            "properties": {
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              },
              "owner": {
                "type": "string"
              },
              "needed_for": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "human_confirmation": {
          "type": "object",
          "required": [
            "required",
            "status"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "not_required",
                "pending",
                "confirmed",
                "rejected"
              ]
            },
            "review_scope": {
              "type": "string"
            },
            "confirmed_by": {
              "type": "string"
            },
            "confirmed_at": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "recovery_context": {
          "type": "object",
          "required": [
            "last_stable_stage",
            "resume_instruction",
            "affected_stages",
            "can_resume"
          ],
          "properties": {
            "last_stable_stage": {
              "type": "string",
              "enum": [
                "S1_SCOPE_CONFIRMATION",
                "S2_EVIDENCE_INVENTORY",
                "S3_PROFESSIONAL_DIAGNOSIS",
                "S4_SOLUTION_DESIGN",
                "S5_HUMAN_CONFIRMATION",
                "S6_FINAL_DELIVERY",
                "PAUSED",
                "FAILED"
              ]
            },
            "resume_instruction": {
              "type": "string",
              "minLength": 1
            },
            "affected_stages": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "S1_SCOPE_CONFIRMATION",
                  "S2_EVIDENCE_INVENTORY",
                  "S3_PROFESSIONAL_DIAGNOSIS",
                  "S4_SOLUTION_DESIGN",
                  "S5_HUMAN_CONFIRMATION",
                  "S6_FINAL_DELIVERY",
                  "PAUSED",
                  "FAILED"
                ]
              },
              "uniqueItems": true
            },
            "can_resume": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "change_log": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_type",
              "reason",
              "affected_stages",
              "occurred_at"
            ],
            "properties": {
              "event_type": {
                "type": "string",
                "enum": [
                  "resume",
                  "target_change",
                  "stage_rollback",
                  "interruption"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "from_stage": {
                "type": "string",
                "enum": [
                  "S1_SCOPE_CONFIRMATION",
                  "S2_EVIDENCE_INVENTORY",
                  "S3_PROFESSIONAL_DIAGNOSIS",
                  "S4_SOLUTION_DESIGN",
                  "S5_HUMAN_CONFIRMATION",
                  "S6_FINAL_DELIVERY",
                  "PAUSED",
                  "FAILED"
                ]
              },
              "to_stage": {
                "type": "string",
                "enum": [
                  "S1_SCOPE_CONFIRMATION",
                  "S2_EVIDENCE_INVENTORY",
                  "S3_PROFESSIONAL_DIAGNOSIS",
                  "S4_SOLUTION_DESIGN",
                  "S5_HUMAN_CONFIRMATION",
                  "S6_FINAL_DELIVERY",
                  "PAUSED",
                  "FAILED"
                ]
              },
              "affected_stages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "S1_SCOPE_CONFIRMATION",
                    "S2_EVIDENCE_INVENTORY",
                    "S3_PROFESSIONAL_DIAGNOSIS",
                    "S4_SOLUTION_DESIGN",
                    "S5_HUMAN_CONFIRMATION",
                    "S6_FINAL_DELIVERY",
                    "PAUSED",
                    "FAILED"
                  ]
                },
                "uniqueItems": true
              },
              "occurred_at": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "minimal_context": {
          "type": "object",
          "required": [
            "user_goal",
            "scope"
          ],
          "properties": {
            "user_goal": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "constraints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "last_user_instruction": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "resume_mode"
        ],
        "properties": {
          "resume_mode": {
            "enum": [
              "resume",
              "target_change",
              "stage_rollback"
            ]
          }
        }
      },
      "then": {
        "required": [
          "agent_state"
        ]
      }
    }
  ]
}
